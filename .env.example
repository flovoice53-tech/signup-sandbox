# Vultr Serverless Inference (OpenAI-compatible)
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=
# 1 = also send page screenshots (only for models that accept images)
LLM_VISION=0

# docker = real isolation (production); local = child processes (development only)
SANDBOX_DRIVER=docker

# Web UI / API
PORT=4000
MAX_CONCURRENT=2
RUNS_PER_IP_PER_HOUR=6
# Lets the operator run against a custom URL: POST /api/runs {"url": "...", "token": "..."}
RUN_TOKEN=

# Demo signup sites (their host is the only one the sandbox may reach)
DEMO_PORT=4100
DEMO_PUBLIC_URL=https://demo.example.com
DEMO_FROM="Acme Notes (demo) <demo@example.com>"
# SMTP for the demo sites' verification emails, e.g. smtps://resend:KEY@smtp.resend.com:465
SMTP_URL=

# Test inboxes: receivemail (default) or local (development, no SMTP needed)
INBOX=receivemail
# Optional receivemail.dev Pro key
RECEIVEMAIL_API_KEY=
# Optional: DNS canary for npm run bench (see README, Deploy)
# DNS_CANARY_ZONE=dns.example.com
# DNS_CANARY_API=http://127.0.0.1:4053
# Optional: OCI runtime for the browser container (recommended: runsc, i.e. gVisor)
# SANDBOX_RUNTIME=runsc
