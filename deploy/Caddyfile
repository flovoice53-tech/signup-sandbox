{
	# A request whose Host differs from its TLS SNI is refused (421), so a
	# tunnel the proxy allowed for one host cannot reach the other site here.
	servers {
		strict_sni_host on
	}
}

APP_HOST {
	encode gzip
	reverse_proxy 127.0.0.1:4000 {
		flush_interval -1
	}
}

DEMO_HOST {
	reverse_proxy 127.0.0.1:4100
}
